DATABASE_URL="file:./dev.db"
PORT=3001

# Shopping list email (optional — without these the email button returns a
# friendly error). Preferred channel: AgentMail (https://agentmail.to).
# AGENTMAIL_API_KEY is the key itself; AGENTMAIL_API_KEY_FILE a path to a file
# containing it (the pattern used by the desktop email agent). Falls back to
# SMTP when only SMTP_* are set.
AGENTMAIL_API_KEY=
AGENTMAIL_API_KEY_FILE=
AGENTMAIL_INBOX=user@agentmail.to
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SHOPPING_EMAIL_TO=

# AI assistant chat (any OpenAI-compatible provider). Easiest: configure it in
# the app — first-run wizard, or the ⚙ button in the Assistant view — which
# writes this file for you. Without a key the Assistant view shows a hint.
# CHAT_API_KEY=
# CHAT_API_KEY_FILE=
# CHAT_BASE_URL=https://opencode.ai/zen/go/v1
# CHAT_MODEL=deepseek-v4-flash

# Weekly digest email (optional): DIGEST_ENABLED=1 sends Mondays 08:00.
# Recipient falls back to SHOPPING_EMAIL_TO.
# DIGEST_ENABLED=1
# DIGEST_TO=you@example.com

# Folder watcher (optional poor man's bank sync): drop bank CSV exports in a
# folder and they import automatically. Filenames must start with the account
# name (e.g. "Account_2026-08.csv"); IMPORT_WATCH_ACCOUNT is the fallback.
# IMPORT_WATCH_DIR=/path/to/csv/inbox
# IMPORT_WATCH_ACCOUNT=
