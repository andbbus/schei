DATABASE_URL="file:./dev.db"
PORT=3001

# Shopping list email (optional — without these the email button returns a
# friendly error). Preferred channel: AgentMail (https://agentmail.to).
# AGENTMAIL_API_KEY is the key itself; AGENTMAIL_API_KEY_FILE a path to a file
# containing it (the pattern used by the desktop email agent). Falls back to
# SMTP when only SMTP_* are set.
AGENTMAIL_API_KEY=
AGENTMAIL_API_KEY_FILE=
AGENTMAIL_INBOX=user@agentmail.to
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SHOPPING_EMAIL_TO=
